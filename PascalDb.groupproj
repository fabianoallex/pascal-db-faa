    </ProjectExtensions>
    <Target Name="PascalDb_UnitTests">
        <MSBuild Projects="tests\Unit\PascalDb.UnitTests.dproj"/>
    </Target>
    <Target Name="PascalDb_UnitTests:Clean">
        <MSBuild Projects="tests\Unit\PascalDb.UnitTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PascalDb_UnitTests:Make">
        <MSBuild Projects="tests\Unit\PascalDb.UnitTests.dproj" Targets="Make"/>
