# build output
lib/
backup/
*.exe
*.o
*.a
*.ppu
*.rsj
*.compiled
*.dcu
Win32/
Win64/
linux/

# .res generated by the IDE (default icon) - regenerable
*.res

# ELF binary (no extension) produced by lazbuild on Linux in the project folder
tests/Unit/fpc/PascalDbUnitTestsFpc
samples/01-mock-repository/MockRepository
samples/02-quickstart/Quickstart
samples/03-migrations/Migrations
samples/04-optionals/Optionals
samples/05-pool/PoolUnderLoad
samples/06-json/JsonApi

# test script logs
samples/*/build.log
tests/Unit/fpc/build.log
tests/Unit/fpc/run.log

# NUnit report produced by the DUnitX runner
dunitx-results.xml

# session/IDE files
*.lps
*.local
*.identcache
*.stat
__history/
__recovery/

# test SQL resources are generated by tools/build_sql_res.py and versioned
!tests/Unit/sql/*.res
!samples/03-migrations/sql/*.res

# integration test logs and databases
tests/Integration/fpc/build.log
tests/Integration/fpc/*.log
tests/Integration/fpc-zeos/*.log
*.fdb

# written by lazbuild in the working folder (a copy of the Lazarus user package links)
packagefiles.xml

# downloaded by tools/ci-test.sh (ZeosLib)
.ci/

# local third-party binaries for Windows test runs (e.g. sqlite.org's sqlite3.dll); see CLAUDE.md
.deps/
